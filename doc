http://localhost:8080/api/documents

# 1. Neues React-Projekt mit Vite erstellen (Vite ist viel schneller als create-react-app)
npm create vite@latest dms-frontend -- --template react

# 2. In den Ordner wechseln
cd dms-frontend

# 3. Axios (für API-Requests) installieren
npm install axios

# 4. Tailwind CSS für das Styling installieren
npm install -D tailwindcss postcss autoprefixer
npx tailwindcss init -p
